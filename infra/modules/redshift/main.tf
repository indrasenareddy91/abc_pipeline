# Redshift Serverless: the warehouse (gold star schema, KPI tables, ops tables).
# - Billed per second only while queries run (RPU-hours); idle = $0 compute, storage ~$0.024/GB-month.
# - A daily RPU-hour usage limit DEACTIVATES the workgroup when reached: a hard cost cap.
# - Admin password generated by Redshift and kept in Secrets Manager (never in code or state).
# - Not publicly accessible. Glue jobs and the dashboard use the Redshift Data API (HTTPS, IAM + secret),
#   so no network path is needed; port 5439 is open only to the dashboard server's security group
#   (for an SSM port-forward with a SQL client).

variable "name" { type = string }
variable "vpc_id" { type = string }
variable "subnet_ids" { type = list(string) }
variable "app_security_group_id" { type = string }
variable "db_name" { type = string }
variable "admin_username" { type = string }
variable "base_capacity" { type = number }
variable "max_rpu_hours_per_day" { type = number }

resource "aws_security_group" "redshift" {
  name        = "${var.name}-redshift-sg"
  description = "Redshift Serverless: 5439 from the dashboard server only"
  vpc_id      = var.vpc_id
  tags        = { Name = "${var.name}-redshift-sg" }
}

resource "aws_vpc_security_group_ingress_rule" "from_app" {
  security_group_id            = aws_security_group.redshift.id
  referenced_security_group_id = var.app_security_group_id
  ip_protocol                  = "tcp"
  from_port                    = 5439
  to_port                      = 5439
  description                  = "Redshift from the dashboard server only"
}

resource "aws_redshiftserverless_namespace" "this" {
  namespace_name        = "${var.name}-ns"
  db_name               = var.db_name
  admin_username        = var.admin_username
  manage_admin_password = true # Redshift creates + rotates-ready secret in Secrets Manager
}

resource "aws_redshiftserverless_workgroup" "this" {
  workgroup_name       = "${var.name}-wg"
  namespace_name       = aws_redshiftserverless_namespace.this.namespace_name
  base_capacity        = var.base_capacity
  publicly_accessible  = false
  enhanced_vpc_routing = false
  subnet_ids           = var.subnet_ids
  security_group_ids   = [aws_security_group.redshift.id]
}

# Cost cap: after N RPU-hours in a day the workgroup is deactivated until the next day.
resource "aws_redshiftserverless_usage_limit" "daily" {
  resource_arn  = aws_redshiftserverless_workgroup.this.arn
  usage_type    = "serverless-compute"
  amount        = var.max_rpu_hours_per_day
  period        = "daily"
  breach_action = "deactivate"
}

output "workgroup_name" { value = aws_redshiftserverless_workgroup.this.workgroup_name }
output "workgroup_arn" { value = aws_redshiftserverless_workgroup.this.arn }
output "namespace_name" { value = aws_redshiftserverless_namespace.this.namespace_name }
output "db_name" { value = aws_redshiftserverless_namespace.this.db_name }
output "secret_arn" { value = aws_redshiftserverless_namespace.this.admin_password_secret_arn }
output "endpoint" { value = aws_redshiftserverless_workgroup.this.endpoint[0].address }
output "security_group_id" { value = aws_security_group.redshift.id }
